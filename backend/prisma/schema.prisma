// Matriq — Prisma Schema
// Every table and field matches docs/data-model.md.
// Money stored as integer minor units (kobo), never float.
// Soft deletes on financial/audit-relevant tables.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ── Enums ──────────────────────────────────────────────────────────

enum RegistrationType {
  staylite
  fresher
}

enum MatricStatus {
  confirmed
  provisional
}

enum AssociationStatus {
  active
  suspended
}

enum ExecutiveRole {
  president
  treasurer
  pro
}

enum MembershipStatus {
  live
  pending
}

enum PaymentStatus {
  pending
  processing
  successful
  failed
  cancelled
  refunded
  disputed
}

enum DocumentType {
  privacy_policy
  terms_and_conditions
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum AuditActorType {
  executive
  admin
  student
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum VaultItemType {
  past_question
  material
}

enum VaultVisibility {
  public
  private
}

// Lifecycle of a student report against a public library document.
enum ReportStatus {
  open
  resolved
  dismissed
}

// Which report categories a student can choose when flagging a resource.
enum ReportReason {
  inappropriate
  irrelevant
  duplicate
  incorrectly_categorized
}

enum InstitutionType {
  university
  polytechnic
  college_of_education
}

// ── Resource Audit Engine ──────────────────────────────────────────
// Lifecycle of a student-submitted academic resource on its way into the
// shared library. The engine is interface-agnostic: the app, website, admin
// tools and (future) Telegram bot all submit through the same internal API.
// See src/resource-audit/README.md for the architecture and state machine.
enum ResourceAuditStatus {
  received
  validating
  duplicate_check
  extracting
  ocr_processing
  auditing
  pending_human_review
  approved
  rejected
  needs_information
  reward_pending
  reward_eligible
  reward_ineligible
  processing_library
  published
  failed
}

// Reward evaluation outcome, tracked separately from the audit state so a
// reward decision can change without moving the pipeline.
enum ResourceRewardStatus {
  none
  pending
  eligible
  ineligible
}

// Downstream library publication status (into the shared Vault).
enum ResourceLibraryStatus {
  none
  pending
  processing
  published
  failed
}

// Where the submission came from. Telegram is a FUTURE channel — the engine
// itself never talks to Telegram; a bot adapter will call the same API.
enum SubmissionSource {
  app
  web
  admin
  telegram
}

// What kind of academic material this is (drives reviewer expectations).
enum ResourceMaterialType {
  past_question
  lecture_note
  handout
  slide_deck
  textbook_summary
  other
}

// ── Tables ─────────────────────────────────────────────────────────

// ── Academic hierarchy (institution → faculties → departments) ──────
// The dropdown cascade used at registration and when the admin scopes an
// association to a specific faculty or department. Names are the source of
// truth for matching students to associations.
model Institution {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @unique
  shortName String?         @map("short_name")
  type      InstitutionType @default(university)
  state     String? // e.g. "Lagos", "Oyo"
  createdAt DateTime        @default(now()) @map("created_at")

  faculties           Faculty[]
  users               User[]
  associations        Association[]
  vaultItems          VaultItem[]
  resourceSubmissions ResourceSubmission[]

  @@map("institutions")
}

model Faculty {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  name          String
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departments Department[]

  @@unique([institutionId, name])
  @@map("faculties")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  facultyId String   @map("faculty_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([facultyId, name])
  @@map("departments")
}

model User {
  id                           String           @id @default(uuid()) @db.Uuid
  fullName                     String           @map("full_name")
  email                        String           @unique
  passwordHash                 String?          @map("password_hash") // null for accounts not yet fully registered
  registrationType             RegistrationType @map("registration_type")
  matricNumber                 String?          @map("matric_number")
  jambNumber                   String?          @map("jamb_number")
  matricStatus                 MatricStatus?    @map("matric_status")
  institutionId                String?          @map("institution_id") @db.Uuid
  faculty                      String
  department                   String
  level                        String
  emailVerified                Boolean          @default(false) @map("email_verified")
  verificationToken            String?          @unique @map("verification_token")
  // 6-digit email verification code (stored in verificationToken). Expiry
  // guards against brute force — expired codes are rejected by verifyEmail.
  verificationCodeExpiresAt    DateTime?        @map("verification_code_expires_at")
  // Rolling 1-hour window for verification emails (register + resend). Cap of
  // 5 per hour per account — enforced in AuthService with a clear retry message.
  verificationEmailCount       Int              @default(0) @map("verification_email_count")
  verificationEmailWindowStart DateTime?        @map("verification_email_window_start")
  // Optional date of birth — collected after email verification, before the
  // dashboard (scroll-picker UI in the app). Nullable: legacy accounts are
  // prompted to complete their profile on next launch.
  dateOfBirth                  DateTime?        @map("date_of_birth")
  // Referral invite code captured at registration, consumed (and cleared) on
  // email verification — the moment the invitee is provably a genuine new
  // student. Self-referral and double-conversion are rejected at consume time.
  pendingReferralCode          String?          @map("pending_referral_code")
  // Profile picture: S3 object key when object storage is enabled, otherwise
  // a base64 data-URI (vault-style fallback). Null = no photo set.
  profilePhotoUrl              String?          @map("profile_photo_url")
  mfaEnabled                   Boolean          @default(false) @map("mfa_enabled")
  mfaSecret                    String?          @map("mfa_secret") // TOTP secret, encrypted/encoded
  createdAt                    DateTime         @default(now()) @map("created_at")
  updatedAt                    DateTime         @updatedAt @map("updated_at")
  deletedAt                    DateTime?        @map("deleted_at")
  // Spec §10: scheduled hard deletion. Set on request (6 months out), cleared
  // automatically by any login before the date; a background sweep hard-
  // deletes the account afterwards. A scheduled account is quietly hidden.
  deletionScheduledAt          DateTime?        @map("deletion_scheduled_at")

  // Relations
  memberships          Membership[]
  payments             Payment[]
  referralsGiven       Referral[]              @relation("Referrer")
  referralsReceived    Referral[]              @relation("ReferredUser")
  announcementReads    AnnouncementRead[]
  eventRsvps           EventRsvp[]
  executiveRoles       AssociationExecutive[]
  verificationRequests VerificationRequest[]
  aiQueryLogs          AiQueryLog[]
  aiDocumentsSubmitted AiDocument[]            @relation("Submitter")
  legalAcceptances     LegalAcceptance[]
  refreshTokenFamilies RefreshTokenFamily[]
  eventAttendance      EventAttendance[]
  vaultItems           VaultItem[]
  notifications        Notification[]
  pushDevices          PushDevice[]
  institution          Institution?            @relation(fields: [institutionId], references: [id])
  entitlements         MagicPlusEntitlement?
  focusSessions        FocusModeSession[]
  focusUsage           FocusModeUsage[]
  focusClarifications  FocusClarification[]
  librarySaves         LibrarySave[]
  libraryViews         LibraryView[]
  libraryReports       LibraryReport[]
  achievementUnlocks   AchievementUnlock[]
  deepReadJobs         DeepReadJob[]
  activityJournal      ActivityJournalEntry[]
  masteryPasses        MasteryCheckpointPass[]
  resourceSubmissions  ResourceSubmission[]

  @@map("users")
}

model Association {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  shortCode      String            @unique @map("short_code")
  institutionId  String?           @map("institution_id") @db.Uuid
  faculty        String
  department     String? // null = faculty-wide; set = department-specific
  whatsappNumber String            @map("whatsapp_number")
  email          String?           @unique // association dashboard login
  passwordHash   String?           @map("password_hash")
  status         AssociationStatus @default(active)
  transparency   Json? // president-editable "where dues go" breakdown
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  // Relations
  executives           AssociationExecutive[]
  memberships          Membership[]
  fees                 Fee[]
  announcements        Announcement[]
  events               Event[]
  aiDocuments          AiDocument[]
  verificationRequests VerificationRequest[]
  vaultItems           VaultItem[]
  timetableUpdates     TimetableUpdate[]
  institution          Institution?           @relation(fields: [institutionId], references: [id])

  @@map("associations")
}

model AssociationExecutive {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String?       @map("user_id") @db.Uuid // nullable — separate exec accounts per docs/data-model.md
  associationId String        @map("association_id") @db.Uuid
  role          ExecutiveRole
  mfaEnabled    Boolean       @default(false) @map("mfa_enabled") // must be true before usable — security.md
  mfaSecret     String?       @map("mfa_secret") // TOTP secret
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  user                User?                 @relation(fields: [userId], references: [id])
  association         Association           @relation(fields: [associationId], references: [id])
  announcements       Announcement[]
  eventsCreated       Event[]               @relation("EventAuthor")
  receiptVerified     Receipt[]
  verificationReviews VerificationRequest[] @relation("Reviewer")
  timetableUpdates    TimetableUpdate[]

  @@unique([userId, associationId])
  @@map("association_executives")
}

model Membership {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  associationId String           @map("association_id") @db.Uuid
  status        MembershipStatus @default(pending)
  joinedAt      DateTime         @default(now()) @map("joined_at")

  // Relations
  user        User        @relation(fields: [userId], references: [id])
  association Association @relation(fields: [associationId], references: [id])

  @@unique([userId, associationId])
  @@map("memberships")
}

model VerificationRequest {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  associationId        String             @map("association_id") @db.Uuid
  documentStorageRef   String             @map("document_storage_ref") // GCS object path — private bucket
  documentOriginalName String             @map("document_original_name")
  documentMimeType     String             @map("document_mime_type")
  status               VerificationStatus @default(pending)
  reviewedBy           String?            @map("reviewed_by") @db.Uuid
  reviewedAt           DateTime?          @map("reviewed_at")
  rejectionReason      String?            @map("rejection_reason")
  createdAt            DateTime           @default(now()) @map("created_at")

  // Relations
  user        User                  @relation(fields: [userId], references: [id])
  association Association           @relation(fields: [associationId], references: [id])
  reviewer    AssociationExecutive? @relation("Reviewer", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([associationId, status])
  @@map("verification_requests")
}

model Fee {
  id            String   @id @default(uuid()) @db.Uuid
  associationId String   @map("association_id") @db.Uuid
  name          String
  amountKobo    Int      @map("amount_kobo") // integer minor units, never float
  currency      String   @default("NGN")
  dueDate       DateTime @map("due_date") @db.Date
  session       String // e.g. "2026/2027"
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  association Association @relation(fields: [associationId], references: [id])
  payments    Payment[]

  @@map("fees")
}
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  // Nullable to support account hard-delete: payments are kept for financial
  // reconciliation (treasurer dashboards) but anonymised by nulling the link
  // to the deleted student. Receipts keep referencing the payment row.
  userId            String?       @map("user_id") @db.Uuid
  feeId             String        @map("fee_id") @db.Uuid
  amountKobo        Int           @map("amount_kobo") // snapshot at payment time
  status            PaymentStatus @default(pending)
  gatewayReference  String?       @unique @map("gateway_reference")
  internalReference String        @unique @map("internal_reference")
  method            String? // card / bank transfer / USSD from gateway
  paidAt            DateTime?     @map("paid_at")
  refundedAt        DateTime?     @map("refunded_at")
  refundReason      String?       @map("refund_reason")
  disputeReference  String?       @map("dispute_reference")
  rankAtPayment     Int?          @map("rank_at_payment")
  developerFeeKobo  Int           @default(0) @map("developer_fee_kobo") // ₦150 platform fee
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  user    User?    @relation(fields: [userId], references: [id])
  fee     Fee      @relation(fields: [feeId], references: [id])
  receipt Receipt?

  @@index([userId])
  @@map("payments")
}

model Receipt {
  id                    String    @id @default(uuid()) @db.Uuid
  paymentId             String    @unique @map("payment_id") @db.Uuid
  receiptNumber         String    @unique @map("receipt_number")
  qrPayload             String    @map("qr_payload") // signed/verifiable payload, not just display
  issuedAt              DateTime  @default(now()) @map("issued_at")
  verifiedByExecutiveId String?   @map("verified_by_executive_id") @db.Uuid
  verifiedAt            DateTime? @map("verified_at")

  // Relations
  payment             Payment               @relation(fields: [paymentId], references: [id])
  verifiedByExecutive AssociationExecutive? @relation(fields: [verifiedByExecutiveId], references: [id])

  @@map("receipts")
}

model Announcement {
  id                String   @id @default(uuid()) @db.Uuid
  associationId     String   @map("association_id") @db.Uuid
  authorExecutiveId String   @map("author_executive_id") @db.Uuid
  title             String
  body              String
  pinned            Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  association Association          @relation(fields: [associationId], references: [id])
  author      AssociationExecutive @relation(fields: [authorExecutiveId], references: [id])
  reads       AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementRead {
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at")

  // Relations
  announcement Announcement @relation(fields: [announcementId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@id([announcementId, userId])
  @@map("announcement_reads")
}

// ── Admin-controlled Home banners ──────────────────────────────
// Lightweight global announcement strip shown on Home (UI direction: admin-
// controlled, scrollable, minimal — NOT an advertising carousel). Admins
// create/edit/publish/reorder/schedule/remove; students see only published
// banners whose schedule window is open, ordered by sortOrder. Distinct from
// the association-scoped Announcement table above.
model Banner {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  body      String
  linkLabel String?   @map("link_label") // optional action text ("View")
  linkUrl   String?   @map("link_url") // optional http(s) destination
  published Boolean   @default(false)
  startsAt  DateTime? @map("starts_at") // null = no start restriction
  endsAt    DateTime? @map("ends_at") // null = no end restriction
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([published, startsAt, endsAt])
  @@map("banners")
}

model Event {
  id                String   @id @default(uuid()) @db.Uuid
  associationId     String   @map("association_id") @db.Uuid
  authorExecutiveId String   @map("author_executive_id") @db.Uuid
  title             String
  description       String
  location          String
  eventDate         DateTime @map("event_date")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  association Association          @relation(fields: [associationId], references: [id])
  author      AssociationExecutive @relation("EventAuthor", fields: [authorExecutiveId], references: [id])
  rsvps       EventRsvp[]
  attendance  EventAttendance[]

  @@map("events")
}

model EventRsvp {
  eventId String   @map("event_id") @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  rsvpAt  DateTime @default(now()) @map("rsvp_at")

  // Relations
  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@id([eventId, userId])
  @@map("event_rsvps")
}

model EventAttendance {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  checkedInAt DateTime @default(now()) @map("checked_in_at")
  method      String   @default("qr")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("event_attendance")
}

model Referral {
  id             String   @id @default(uuid()) @db.Uuid
  referrerId     String   @map("referrer_id") @db.Uuid
  referredUserId String?  @unique @map("referred_user_id") @db.Uuid // set only on actual signup
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  referrer     User  @relation("Referrer", fields: [referrerId], references: [id])
  referredUser User? @relation("ReferredUser", fields: [referredUserId], references: [id])

  @@map("referrals")
}

model AdminAccount {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  mfaEnabled   Boolean  @default(false) @map("mfa_enabled") // must be true before login
  mfaSecret    String?  @map("mfa_secret") // TOTP secret
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_accounts")
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String         @map("actor_id") @db.Uuid
  action     String // e.g. "announcement.created", "association.suspended"
  targetType String?        @map("target_type")
  targetId   String?        @map("target_id") @db.Uuid
  ipAddress  String         @map("ip_address")
  metadata   Json? // before/after values, freeform
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([actorType, actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model AiDocument {
  id                String                       @id @default(uuid()) @db.Uuid
  sourceType        String                       @map("source_type") // past_question, handout, vault, deep_read
  courseCode        String?                      @map("course_code")
  associationId     String?                      @map("association_id") @db.Uuid
  contentChunk      String                       @map("content_chunk")
  embedding         Unsupported("vector(1536)")? // pgvector — Ollama embeddings
  moderationStatus  ModerationStatus             @default(pending) @map("moderation_status")
  submittedByUserId String?                      @map("submitted_by_user_id") @db.Uuid
  // Idempotent ingestion: unique per-source locator ("vault:<itemId>:chunk3",
  // "deepread:<pageId>"). Re-ingesting the same source updates in place
  // instead of duplicating rows. Null = manually submitted material.
  sourceRef         String?                      @map("source_ref")
  createdAt         DateTime                     @default(now()) @map("created_at")

  // Relations
  association Association? @relation(fields: [associationId], references: [id])
  submitter   User?        @relation("Submitter", fields: [submittedByUserId], references: [id])

  @@unique([sourceRef])
  @@index([sourceType, moderationStatus])
  @@index([submittedByUserId])
  @@map("ai_documents")
}

model AiQueryLog {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  queryText            String   @map("query_text")
  responseText         String   @map("response_text")
  retrievedDocumentIds String[] @map("retrieved_document_ids") @db.Uuid
  // True when the answer came from the Redis cache (zero model cost).
  // Quickie's free daily limit counts only real generations.
  cached               Boolean  @default(false)
  // Which engine answered: ollama | deepseek | nvidia | gemini | placeholder
  engine               String?
  createdAt            DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("ai_query_logs")
}

model VaultItem {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  associationId      String           @map("association_id") @db.Uuid
  courseCode         String           @map("course_code") // normalized uppercase, e.g. "CHM 101"
  title              String
  type               VaultItemType    @default(material)
  visibility         VaultVisibility  @default(public)
  // The original file (object key in the private bucket, or data-URI fallback)
  storageRef         String           @map("storage_ref")
  // Smart storage (spec §7): a lightweight companion generated automatically
  // on upload — image → lower-quality JPEG, anything else → zip. Null when
  // the companion wouldn't actually be smaller.
  companionRef       String?          @map("companion_ref")
  originalName       String           @map("original_name")
  mimeType           String           @map("mime_type")
  sizeBytes          Int              @map("size_bytes")
  // SHA-256 of the original file bytes — upload-dedupe key. Null for legacy
  // items or clients that didn't supply content (data-URI fallbacks).
  contentHash        String?          @map("content_hash")
  companionSizeBytes Int?             @map("companion_size_bytes")
  companionMimeType  String?          @map("companion_mime_type")
  // Public uploads require admin approval before they're visible to others;
  // private uploads are immediately usable by their owner.
  moderationStatus   ModerationStatus @default(pending) @map("moderation_status")
  rejectionReason    String?          @map("rejection_reason")
  reviewedByAdmin    String?          @map("reviewed_by_admin") @db.Uuid
  reviewedAt         DateTime?        @map("reviewed_at")
  downloads          Int              @default(0)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")
  // Discovery metadata (optional, set by the uploader): academic level the
  // material targets (e.g. "100") and the academic session (e.g. "2023/2024").
  level              String?          @map("level")
  session            String?          @map("session")
  // ── Netflix-style library metadata ─────────────────────────────
  // Cross-institution discovery fields (mirror the uploader's profile so the
  // resource can be surfaced by institution/faculty/department regardless of
  // which association it was uploaded under). courseTitle lets search match
  // the human course name, not just the code.
  institutionId      String?          @map("institution_id") @db.Uuid
  faculty            String?          @map("faculty")
  department         String?          @map("department")
  courseTitle        String?          @map("course_title")
  description        String?          @map("description")
  // Public interactions (deduped, see LibraryView/LibrarySave) — kept on the
  // row as denormalised counters for cheap ordering in the popular/trending
  // queries without a GROUP BY every time.
  opens              Int              @default(0) // cumulative (view tracked once/day per user)
  savesCount         Int              @default(0) @map("saves_count")
  // Moderation states beyond the shared enum: active (approved), hidden
  // (removed from discovery after a report/flag), removed (soft-deleted).
  hidden             Boolean          @default(false) @map("hidden")

  // Relations
  user           User            @relation(fields: [userId], references: [id])
  association    Association     @relation(fields: [associationId], references: [id])
  institution    Institution?    @relation(fields: [institutionId], references: [id])
  libraryViews   LibraryView[]
  librarySaves   LibrarySave[]
  libraryReports LibraryReport[]

  @@index([associationId, courseCode])
  @@index([associationId, courseCode, level])
  @@index([courseCode])
  @@index([moderationStatus, visibility])
  @@index([userId])
  // Discovery indexes: public/active filters + cross-institution browse rows.
  @@index([moderationStatus, visibility, hidden, opens])
  @@index([visibility, moderationStatus, createdAt])
  @@index([institutionId, moderationStatus, visibility])
  @@index([faculty, department])
  @@index([contentHash])
  @@map("vault_items")
}

// ── Academic library ("Netflix for Students") ──────────────────
// Discovery / activity layers on top of the shared VaultItem document store.
// Files stay in object storage with metadata + permissions in the DB; these
// tables track per-student activity (all private to the student): recent
// reading with resume position, saved/bookmarked documents, and public-
// resource reports feed into moderation.

// Saved/bookmarked public document (never duplicates the original file — it's
// a reference so the student can find it again quickly). Private to the user.
model LibrarySave {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  vaultItemId String   @map("vault_item_id") @db.Uuid
  savedAt     DateTime @default(now()) @map("saved_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)

  @@unique([userId, vaultItemId])
  @@index([userId])
  @@index([vaultItemId])
  @@map("library_saves")
}

// Per-student reading activity: a resume position (where in the doc they
// stopped) + cumulative opens. Used for "Continue Reading" and lightweight-
// but-genuine popularity (one open counted per user per day keeps the counters
// from being inflated by a single student re-opening a file repeatedly).
model LibraryView {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  vaultItemId  String   @map("vault_item_id") @db.Uuid
  lastViewedAt DateTime @default(now()) @map("last_viewed_at")
  // Opaque resume marker the client persists per document (e.g. scroll offset
  // or last-visible text anchor) so Continue Reading can jump back.
  position     String?  @map("position")
  progress     Float?   @default(0) // 0..1 fraction of the doc considered read
  opens        Int      @default(1) // daily-deduplicated open counter
  lastOpenDay  String?  @map("last_open_day") // YYYY-MM-DD utc, for dedup

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)

  @@unique([userId, vaultItemId])
  @@index([userId, lastViewedAt])
  @@index([vaultItemId])
  @@map("library_views")
}

// A student's flagged report against a public resource. Opens a moderation
// row; admins resolve (content action) or dismiss (bad report). Reported
// documents can be hidden from discovery while under review if serious.
model LibraryReport {
  id              String       @id @default(uuid()) @db.Uuid
  vaultItemId     String       @map("vault_item_id") @db.Uuid
  reporterUserId  String       @map("reporter_user_id") @db.Uuid
  reason          ReportReason @map("reason")
  details         String?      @map("details") // free-text context, optional
  status          ReportStatus @default(open) @map("status")
  resolvedAt      DateTime?    @map("resolved_at")
  resolvedByAdmin String?      @map("resolved_by_admin") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")

  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)
  reporter  User      @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([vaultItemId, status])
  @@index([reporterUserId])
  @@map("library_reports")
}

// ── In-app notification feed (round-2 QA §9) ─────────────────────
// The bell + feed students see inside the app: verification updates, payment
// receipts, new dues, announcements, admin broadcasts. Rows are created
// server-side alongside the business event that triggers them; push (ntfy)
// stays a separate, optional delivery channel on top.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String
  // verification | payment | dues | announcement | broadcast | vault |
  // timetable | update | general
  type      String    @default("general")
  // Deep link target within the app when the student taps the row
  // (e.g. "VerificationStatus", "Fees", "Explore").
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ── Push notification device registrations ─────────────────────
// One row per device (FCM registration token) a student's app registered
// after the user granted notification permission. Tokens are server-side
// secrets — never exposed through any API — and the backend is the only
// sender. Rows are removed when the token dies (FCM says unregistered) or the
// student logs out, so one account can own several devices at once.
model PushDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique // FCM registration token (hex on Android)
  platform   String   @default("android") // android | web
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @updatedAt @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

// ── Real-time class/timetable updates (round-2 QA §2) ─────────────
// An executive or class rep pushes a change ("GST 202 moved to 2pm") scoped
// by department + level; students matching that scope see it in their
// Timetable and get an in-app notification. Null department/level = all.
model TimetableUpdate {
  id                String   @id @default(uuid()) @db.Uuid
  associationId     String   @map("association_id") @db.Uuid
  authorExecutiveId String   @map("author_executive_id") @db.Uuid
  department        String? // null → all departments
  level             String? // null → all levels
  title             String
  body              String
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  association Association          @relation(fields: [associationId], references: [id])
  author      AssociationExecutive @relation(fields: [authorExecutiveId], references: [id])

  @@index([associationId, department, level])
  @@map("timetable_updates")
}

model LegalAcceptance {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  documentType    DocumentType @map("document_type")
  documentVersion String       @map("document_version") // e.g. "1.0"
  acceptedAt      DateTime     @default(now()) @map("accepted_at")
  ipAddress       String       @map("ip_address")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, documentType, documentVersion])
  @@map("legal_acceptances")
}

// ── Public waitlist ─────────────────────────────────────────────

model WaitlistEntry {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  fullName          String?  @map("full_name")
  source            String   @default("landing") // landing, referral, import, …
  status            String   @default("pending") // pending | invited | joined
  // Growth survey (waitlist launch package §3): the honest market research
  // collected at signup + executive identification for the Founding Circle.
  painPoint         String?  @map("pain_point") // "most annoying part of studying"
  isAssociationExec Boolean  @default(false) @map("is_association_exec")
  execLevel         String?  @map("exec_level")
  execDepartment    String?  @map("exec_department")
  execFaculty       String?  @map("exec_faculty")
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("waitlist_entries")
}

// ── Magic Plus entitlements ────────────────────────────────────
// The backend is the AUTHORITY for premium access. A client-side flag is never
// trusted as proof of paid cloud usage; every premium (cloud-AI) request is
// authorised here. One row per user. `source` records how the entitlement was
// granted (free_allowance / subscription / pass / grant) so it can be revoked
// or migrated when real payment providers ship. Extended later with per-plan
// quotas / fair-use policies without changing callers.
model MagicPlusEntitlement {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  plan                String    @default("magic_plus")
  status              String    @default("active") // active | suspended | expired | cancelled
  source              String    @default("free_allowance") // free_allowance | subscription | pass | grant
  // Every new user gets a starter allowance of free cloud Focus Mode
  // generations before Magic Plus is required. Both fields are configurable
  // (the default mirrors FOCUS_FREE_ALLOWANCE; a subscription sets an
  // unlimited/very large number for the paid path).
  freeGenerationLimit Int       @default(10) @map("free_generation_limit")
  freeGenerationsUsed Int       @default(0) @map("free_generations_used")
  startedAt           DateTime  @default(now()) @map("started_at")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("magic_plus_entitlements")
}

// ── Cloud Focus Mode ───────────────────────────────────────────
// A validated, structured, academic concept map generated by a cloud LLM
// (DeepSeek primary with NVIDIA/Gemini fallbacks — all server-side secrets).
// Only safe, reusable academic content is cached; the map is stored once per
// (user, normalized-topic, prompt/model version) and identical topics hit the
// cache rather than re-paying for a second model call.
model FocusModeSession {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  topic         String
  topicHash     String   @map("topic_hash")
  conceptMap    Json     @map("concept_map") // validated Focus Map v1
  promptVersion Int      @default(1) @map("prompt_version")
  provider      String   @default("deepseek")
  model         String
  fromCache     Boolean  @default(false) @map("from_cache")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([topicHash])
  @@map("focus_mode_sessions")
}

// ── Focus Mode clarification (the Questioner) ─────────────────
// One row per intake questionnaire: the model-proposed questions, the
// student's tap-to-answer responses, and (optionally) the session that
// consumed them. Lets generate() verify answers exist, keeps exactly-once
// linkage (a question set maps to one map session), and lets the student
// re-open their answers later.
model FocusClarification {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  topic        String
  questions    Json
  answers      Json?
  sessionMapId String?  @map("session_map_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("focus_clarifications")
}

// ── Student achievements (Achievement Board) ──────────────────
// One row per (student, achievement) the moment it is earned, so the board
// can show "earned on" dates and "how it was earned" from real data. The
// evaluation itself is deterministic server-side (see achievements module) —
// the table only records the fact + timestamp of earning.
model AchievementUnlock {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id")
  earnedAt      DateTime @default(now()) @map("earned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("achievement_unlocks")
}

// ── Cloud Focus Mode usage / economics ─────────────────────────
// One row per cloud Focus Mode request so Matriq can measure the real cost of
// the feature before scaling: tokens, latency, provider, model and an
// estimated cost in micro-dollars. Populated for both generation and
// per-concept expansion so per-user abuse limits and unit economics are
// auditable.
model FocusModeUsage {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  sessionId           String?  @map("session_id") @db.Uuid
  operation           String   @default("generate") // generate | expand
  provider            String   @default("deepseek")
  model               String
  promptVersion       Int      @default(1) @map("prompt_version")
  promptTokens        Int      @default(0) @map("prompt_tokens")
  completionTokens    Int      @default(0) @map("completion_tokens")
  totalTokens         Int      @default(0) @map("total_tokens")
  latencyMs           Int      @default(0) @map("latency_ms")
  estimatedCostMicros Int      @default(0) @map("estimated_cost_micros")
  cached              Boolean  @default(false)
  error               Boolean  @default(false)
  errorKind           String?  @map("error_kind") // timeout | provider | schema | malformed_json | empty
  createdAt           DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("focus_mode_usage")
}

// ── Deep Read — premium handwriting OCR (Magic Plus) ───────────
// An async job per batch of photographed pages. Pro-class vision
// transcription runs server-side (rate-limited by a global worker
// semaphore, env-tuned for free-tier vs billed Gemini), results are
// cached per page-image hash so retries never re-bill the API, and
// page images live in object storage like every other study file.
// Free tier gets a small daily allowance (DEEP_READ_FREE_DAILY);
// Magic Plus users get DEEP_READ_PREMIUM_DAILY.
model DeepReadJob {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  // queued | processing | done | failed | partially_failed
  status         String    @default("queued")
  // denormalized count for list views; true count = pages rows
  pageCount      Int       @default(0) @map("page_count")
  completedPages Int       @default(0) @map("completed_pages")
  failedPages    Int       @default(0) @map("failed_pages")
  // which engine produced the best result for the hardest page:
  // deep_read (pro model) | rescue (flash) | ocr (tesseract/mlkit)
  bestEngine     String?   @map("best_engine")
  // optional title the student gave the batch ("BIO 201 notes, week 3")
  title          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages DeepReadPage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("deep_read_jobs")
}

model DeepReadPage {
  id           String    @id @default(uuid()) @db.Uuid
  jobId        String    @map("job_id") @db.Uuid
  // 1-based position in the batch
  pageNumber   Int       @map("page_number")
  // object-storage key of the (preprocessed) page image; null when storage
  // is disabled (image stays in memory for the job only)
  imageRef     String?   @map("image_ref")
  // pending | processing | done | failed | empty (no legible text)
  status       String    @default("pending")
  engine       String?
  // per-page transcription confidence estimate (0-100), null when unknown
  confidence   Int?
  // SHA-256 of the raw upload — the OCR result cache key. Retries and
  // re-uploads of the same page never re-bill the vision API.
  contentHash  String    @map("content_hash")
  text         String?
  // structured blocks extracted from `text` (headings/paragraphs/lists) —
  // feeds the Reflow reader directly
  blocks       Json?
  // student corrected the transcription on the review screen
  edited       Boolean   @default(false)
  errorMessage String?   @map("error_message")
  latencyMs    Int       @default(0) @map("latency_ms")
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  job DeepReadJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, pageNumber])
  @@index([contentHash])
  @@map("deep_read_pages")
}

// ── Refresh token rotation ──────────────────────────────────────

model RefreshTokenFamily {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]

  @@map("refresh_token_families")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  familyId   String   @map("family_id") @db.Uuid
  tokenHash  String   @map("token_hash") // SHA-256 of the JWT refresh token
  used       Boolean  @default(false)
  replacedBy String?  @map("replaced_by") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  family RefreshTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ── Meaningful-activity journal (achievements §) ────────────────
// Server-authoritative record of activities that count toward streaks,
// First Spark, Deep Thinker, Knowledge Explorer and the rest. Every entry is
// idempotent: (userId, eventKey) is unique, so replays, retries and racing
// clients can never double-credit. A day only counts for streaks when it has
// at least one journal entry — app launches are never journaled.
model ActivityJournalEntry {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  // focus_map | mastery_pass | note_save | task_complete | upload |
  // library_save | ai_generation | deep_read | referral_verified
  kind         String   @map("kind")
  // "{kind}:{naturalId}" — e.g. "focus_map:f3c2..." — the idempotency key.
  // Natural ids are the underlying record ids, so replaying the same event
  // (retry, double-tap, re-sync) lands on the same key and is a no-op.
  eventKey     String   @map("event_key")
  // UTC calendar day (midnight) this entry counts toward.
  activityDate DateTime @map("activity_date")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, activityDate])
  @@map("activity_journal")
}

// ── Focus Mode mastery checkpoints ─────────────────────────────
// One row per passed checkpoint, keyed to the map + session it came from so
// the same checkpoint can never be passed twice, by retry or replay.
model MasteryCheckpointPass {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  focusSessionId String   @map("focus_session_id") @db.Uuid
  mapId          String   @map("map_id") @db.Uuid
  score          Int      @default(0)
  passedAt       DateTime @default(now()) @map("passed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, focusSessionId, mapId])
  @@index([userId])
  @@map("mastery_checkpoint_passes")
}

// ── Resource Audit Engine — submission + audit record ───────────
// One row per submitted resource. The original file is immutable in object
// storage; every processing stage reads it fresh, which is what makes stages
// retryable and idempotent. AI fields are advisory (the human decision is
// authoritative); the pipeline is driven by ResourceAuditService.advance().
model ResourceSubmission {
  id                   String                @id @default(uuid()) @db.Uuid
  studentId            String                @map("student_id") @db.Uuid
  // Channel that delivered the submission (app now; telegram later).
  source               SubmissionSource      @default(app)
  // ── File facts (captured at submit time, immutable) ──
  fileName             String                @map("file_name")
  fileType             String                @map("file_type") // MIME type
  fileSize             Int                   @map("file_size") // bytes
  // SHA-256 of the original bytes — duplicate-detection key.
  fileHash             String                @map("file_hash")
  pageCount            Int?                  @map("page_count")
  // Object-storage key of the ORIGINAL, untouched upload (private bucket).
  storageRef           String                @map("storage_ref")
  // ── Academic context (normalized at submit time) ──
  institutionId        String?               @map("institution_id") @db.Uuid
  universityName       String?               @map("university_name") // denormalized for display
  faculty              String?
  department           String?
  courseCode           String                @map("course_code")
  level                String?
  materialType         ResourceMaterialType  @default(other) @map("material_type")
  academicSession      String?               @map("academic_session") // e.g. "2023/2024"
  // Student's rights declaration ("I have the right to share this") — the
  // version records which agreement text they accepted.
  rightsDeclared       Boolean               @map("rights_declared")
  rightsVersion        String?               @map("rights_version")
  submittedAt          DateTime              @default(now()) @map("submitted_at")
  // ── Pipeline state ──
  auditStatus          ResourceAuditStatus   @default(received) @map("audit_status")
  // Extracted plain text (PDFs for now; OCR output later) — audit input.
  extractedText        String?               @map("extracted_text")
  // ── AI (advisory, never authoritative) ──
  aiRecommendation     String?               @map("ai_recommendation") // approve | reject | needs_review | duplicate
  aiConfidence         Int?                  @map("ai_confidence") // 0-100
  aiSummary            String?               @map("ai_summary")
  aiAuditedAt          DateTime?             @map("ai_audited_at")
  // ── Human decision (authoritative) ──
  humanDecision        String?               @map("human_decision") // approved | rejected | needs_information
  decisionReason       String?               @map("decision_reason")
  reviewerId           String?               @map("reviewer_id") @db.Uuid // admin account id
  reviewedAt           DateTime?             @map("reviewed_at")
  // ── Reward + library processing ──
  rewardStatus         ResourceRewardStatus  @default(none) @map("reward_status")
  rewardReason         String?               @map("reward_reason")
  libraryStatus        ResourceLibraryStatus @default(none) @map("library_status")
  publishedVaultItemId String?               @map("published_vault_item_id") @db.Uuid
  // ── Failure/retry bookkeeping ──
  attemptCount         Int                   @default(0) @map("attempt_count")
  failureReason        String?               @map("failure_reason")
  lastStageError       String?               @map("last_stage_error")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id])

  @@unique([studentId, fileHash, courseCode])
  @@index([studentId, createdAt])
  @@index([auditStatus])
  @@index([fileHash])
  @@index([institutionId, courseCode])
  @@map("resource_submissions")
}
