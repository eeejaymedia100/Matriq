# Matriq — environment variables (copy to .env and fill in real values)
# NEVER commit .env. This file is a template only.

# ── Database ──
POSTGRES_USER=matriq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=matriq

# ── JWT ──
JWT_SECRET=generate-a-strong-random-secret
JWT_REFRESH_SECRET=generate-another-strong-random-secret

# ── Resend (email) ──
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Paystack (payments — test key for dev/staging) ──
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# ── AI Study Companion (self-hosted Ollama) ──
# Ollama must be reachable from the backend. In docker-compose it is http://ollama:11434.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nemotron-3-super:cloud
# OLLAMA_TIMEOUT_MS=45000

# ── Optional: domain for Caddy TLS ──
# DOMAIN=matriq.example.com
