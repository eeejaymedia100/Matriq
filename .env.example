# Matriq — environment variables (copy to .env and fill in real values)
# NEVER commit .env. This file is a template only.

# ── Database ──
POSTGRES_USER=matriq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=matriq

# ── JWT ──
JWT_SECRET=generate-a-strong-random-secret
JWT_REFRESH_SECRET=generate-another-strong-random-secret

# ── Resend (email) ──
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Paystack (payments — test key for dev/staging) ──
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# ── AI Study Companion (self-hosted Ollama) ──
# Ollama must be reachable from the backend. In docker-compose it is http://ollama:11434.
OLLAMA_HOST=http://localhost:11434
# llama3.2:3b runs on this VM's 3.8GB RAM; pull with: ollama pull llama3.2:3b
# (nemotron-3-super:cloud requires an Ollama cloud login, so it is not the default.)
OLLAMA_MODEL=llama3.2:3b
# Embeddings model (768-dim; padded to the vector(1536) column). Pull with: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text
# Cold model load on CPU can take ~90s — keep the timeout generous.
OLLAMA_TIMEOUT_MS=180000
# AI capacity: Ollama is CPU-bound, so cap concurrent calls. Excess requests
# queue; those waiting longer than AI_QUEUE_TIMEOUT_MS get a 503 "busy" instead
# of stalling the API. Chat generations hold a slot for the whole call; embed
# calls (short) use a separate pool so retrieval stays snappy during chat.
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_EMBED_MAX_CONCURRENCY=2
AI_QUEUE_TIMEOUT_MS=30000

# ── Cloud AI fallbacks (hosted) ──
# NVIDIA NIM hosted LLM — the cloud fallback between Ollama and Gemini. Free
# tier via https://build.nvidia.com. Model must be one your account can call.
NVIDIA_API_KEY=nvapi-xxxxxxxxx
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
# Gemini (OCR, quiz gen, facts). Key lives server-side only.
GEMINI_API_KEY=xxxxxxxxx
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# How long AI answers stay cached (hours). Whole classes ask the same past
# questions, so cache hits absorb most of the peak at scale.
AI_CACHE_TTL_HOURS=24

# DeepSeek — PRIMARY cloud AI (Premium Focus Mode + general-chat fallback).
# This is a SERVER-SIDE SECRET. It must never appear in the React Native
# bundle, logs, or API responses. The mobile app only ever talks to the backend.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# OpenAI-compatible endpoint. deepseek-chat is the cost-efficient model for
# high-volume structured educational generation; switch models here without a redeploy.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=45000
# $ per million tokens used to estimate Focus Mode unit economics (focus_mode_usage.estimated_cost_micros)
DEEPSEEK_INPUT_PRICE_USD_PER_M=0.27
DEEPSEEK_OUTPUT_PRICE_USD_PER_M=1.10

# Cloud Focus Mode (Magic Plus) limits — configurable fair-use, not hardcodes.
# Every new user gets this many free cloud Focus Mode generations before Magic Plus.
FOCUS_FREE_ALLOWANCE=10
# Per-user daily cap on cloud Focus Mode calls (incl. errors) — abuse protection.
FOCUS_DAILY_LIMIT=25
# Cache TTL for normalized, reusable academic Focus Maps (model/prompt-version keyed).
FOCUS_CACHE_TTL_HOURS=48
# Timeout for NVIDIA/Gemini Focus fallback calls.
FOCUS_FALLBACK_TIMEOUT_MS=45000

# ── Process scaling (cluster mode) ──
# WORKERS=0 -> one backend process per CPU core (production default, uses both
# vCPUs on the 2-core VM). WORKERS=1 forces single-process (dev/debug).
# WORKERS=4 pins exactly 4 processes.
WORKERS=0
# Postgres pool per worker (workers × this = max DB connections).
DATABASE_POOL_MAX=5
# Rate limits are stored in Redis (shared across workers) with an automatic
# in-memory fallback — Redis is already a required compose service, so no extra
# setup is needed. REDIS_URL is derived from the compose service name.
REDIS_URL=redis://redis:6379

# ── Push notifications (self-hosted ntfy — OFF by default) ──
# Set NTFY_ENABLED=true to send pushes (verification, payments, announcements,
# security alerts). NTFY_URL points at the ntfy container on the internal network.
NTFY_ENABLED=false
NTFY_URL=http://ntfy:80
# Public base URL subscribers use (set when a domain is live).
# NTFY_BASE_URL=https://ntfy.matriq.app

# ── Real device push (Firebase Cloud Messaging — OFF by default) ──
# FCM is the real channel: notifications appear above every screen and even
# when the app is closed. The app requests notification permission at launch
# and registers its device token with POST /v1/me/push/register. Until these
# are set, pushes fall back to the legacy ntfy topic channel above.
FCM_ENABLED=false
# Firebase project id (optional — falls back to the service account's project_id).
FCM_PROJECT_ID=
# Base64 of the Firebase service-account JSON (Project settings → Service
# accounts → Generate new private key). Server-side secret — never in the app.
FCM_SERVICE_ACCOUNT_B64=

# ── Object storage (MinIO/S3 — OFF by default) ──
# Verification documents are stored in MinIO when S3_ENDPOINT is set; otherwise
# the app falls back to base64 data-URIs (scaffold only).
S3_ENDPOINT=
S3_PORT=9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=matriq
S3_REGION=us-east-1
S3_USE_SSL=false
# MinIO root credentials for the minio container (compose requires these):
MINIO_ROOT_USER=matriq
MINIO_ROOT_PASSWORD=change-me-too

# ── Optional: domain for Caddy TLS ──
# DOMAIN=matriq.app

# ── Optional: browser origins allowed to call the API (comma-separated) ──
# The waitlist site (matriq.com.ng form), the student web app (app.*), the
# Vercel dashboards, and localhost dev. The backend rejects other origins.
# CORS_ORIGIN=https://matriq.com.ng,https://www.matriq.com.ng,https://app.matriq.com.ng,https://admin.matriq.com.ng,https://dashboard.matriq.com.ng,http://localhost:8081

# ── Deep Read (premium handwriting OCR, Magic Plus) ──
# Pro-class Gemini vision model for verbatim handwriting transcription.
# NOTE: gemini-2.5-pro is CLOSED to new API users — use gemini-3.1-pro-preview
# (verified live) or newer. The key is the shared GEMINI_API_KEY (billed).
# DEEP_READ_MODEL=gemini-3.1-pro-preview
# Concurrent Pro transcription calls (billed Tier 1 shares 10k RPM across
# everything on this key; free tier should run 1). Queue waits instead of failing.
# DEEP_READ_CONCURRENCY=2
# Daily page quotas per user: Magic Plus / free-tier taste of the feature.
# DEEP_READ_PREMIUM_DAILY=30
# DEEP_READ_FREE_DAILY=2
# Long-edge pixel cap for preprocessed page photos (smaller = faster/cheaper).
# DEEP_READ_MAX_DIMENSION=2048

# ── Quickie (chat AI) free-tier quota ─────────────────────────────
# Daily cloud-AI questions for free users. Premium (Magic Plus) is unlimited;
# cache hits and offline on-device answers never count. Default: 20.
# QUICKIE_FREE_DAILY=20
