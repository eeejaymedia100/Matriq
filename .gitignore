# Secrets & environment — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account.json
gcp-*.json

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
.expo/
*.tsbuildinfo

# Mobile (Expo)
# android/ and ios/ are generated by `expo prebuild` — never commit them
android/
ios/
*.apk
*.aab
*.ipa

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker-data/

# Test coverage
coverage/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# Terraform / IaC (if used later)
.terraform/
*.tfstate*

# Local Claude / agent config (already tracked via .claude/settings.local.json,
# but block any secrets that might slide in alongside it)
.claude/*.env
.claude/secrets/
