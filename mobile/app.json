{
  "expo": {
    "name": "Matriq",
    "slug": "matriq",
    "version": "0.7.17",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Matriq — The Smart Way to Get Through Semester",
      "shortName": "Matriq",
      "description": "Past questions, offline AI and study tools for how Nigerian students actually study. Works on bad data.",
      "lang": "en",
      "themeColor": "#14061F",
      "backgroundColor": "#0d0620"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.matriq.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive/foreground-light.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "app.matriq.mobile",
      "googleServicesFile": "./google-services.json",
      "versionCode": 25,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/withThemeIcons",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#121212",
            "image": "./assets/splash-icon-dark.png",
            "imageWidth": 160
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Matriq uses your photos to upload a student ID for identity verification and to read study material photos in the AI companion.",
          "cameraPermission": "Matriq uses your camera to photograph your student ID for identity verification."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Matriq uses your microphone to record voice notes for the AI study companion."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      "expo-build-properties",
      [
        "llama.rn",
        {
          "enableOpenCL": false,
          "forceCxx20": true,
          "enableEntitlements": false
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification_icon.png",
          "color": "#7B4BC4",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.matriq.com.ng/v1"
    }
  }
}
