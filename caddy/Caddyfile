# Matriq — Caddy reverse proxy (TLS termination, HTTPS only per security.md).
# The ONLY service binding to public ports.
#
# matriq.com.ng       → waitlist landing page (static) + /v1 proxied to backend
# api.matriq.com.ng   → backend API
# Certificates: Caddy auto-issues Let's Encrypt certs once DNS resolves here.

# ── Public waitlist landing page ───────────────────────────────────
matriq.com.ng {
    root * /srv/waitlist
    encode gzip

    # API calls from the landing page (same-origin /v1/*) go to the backend.
    handle /v1/* {
        reverse_proxy backend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Everything else is the static landing page.
    handle {
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# ── API subdomain ──────────────────────────────────────────────────
api.matriq.com.ng {
    reverse_proxy backend:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# ── HTTP -> HTTPS redirect (our hosts only) ────────────────────────
http://matriq.com.ng, http://api.matriq.com.ng {
    redir https://{host}{uri} permanent
}

# ── Temporary: raw VM IP API endpoint ───────────────────────────────
# Lets the mobile student app be tested TODAY while the .ng nameserver
# change propagates (up to 24h). Once DNS is live, clients switch to
# https://api.matriq.com.ng/v1 and this block can be removed.
http://34.28.210.233 {
    handle /v1/* {
        reverse_proxy backend:3000 {
            header_up Host api.matriq.com.ng
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto http
        }
    }
    handle {
        respond "Matriq API — use /v1/*" 200
    }
}

# ── Catch-all (ngrok/dev tunnel): any host → API + APK download ─────
# Lets phones reach the API TODAY via an OUTBOUND ngrok tunnel (no
# inbound firewall needed). The tunnel forwards with a random *.ngrok
# Host header, so this block matches any unknown host on :80.
# Once the GCP firewall is open and DNS propagates, clients switch to
# https://api.matriq.com.ng/v1 and this block can be removed.
http:// {
    handle /v1/* {
        reverse_proxy backend:3000 {
            header_up Host api.matriq.com.ng
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
    handle_path /download/* {
        root * /srv/waitlist
        file_server
    }
    handle {
        respond "Matriq API — use /v1/*" 200
    }
}
