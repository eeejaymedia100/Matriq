# Matriq — Caddy reverse proxy (TLS termination, HTTPS only per security.md).
# The ONLY service binding to public ports.
#
# matriq.com.ng       → waitlist landing page (static) + /v1 proxied to backend
# api.matriq.com.ng   → backend API
# Certificates: Caddy auto-issues Let's Encrypt certs once DNS resolves here.

# ── Public waitlist landing page ───────────────────────────────────
matriq.com.ng {
    root * /srv/waitlist
    encode gzip

    # API calls from the landing page (same-origin /v1/*) go to the backend.
    handle /v1/* {
        reverse_proxy backend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Everything else is the static landing page.
    handle {
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# ── API subdomain ──────────────────────────────────────────────────
api.matriq.com.ng {
    reverse_proxy backend:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# ── HTTP -> HTTPS redirect (our hosts only) ────────────────────────
http://matriq.com.ng, http://api.matriq.com.ng {
    redir https://{host}{uri} permanent
}
