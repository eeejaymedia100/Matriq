# Matriq — Caddy reverse proxy (TLS termination, HTTPS only per security.md).
# The ONLY service binding to public ports.
#
# matriq.com.ng       → waitlist landing page (static)
# app.matriq.com.ng   → student web app (static React Native web export)
# api.matriq.com.ng   → backend API
#
# Certificates: Caddy auto-issues Let's Encrypt certs once DNS resolves here.
#
# Production notes:
# - The temporary raw-IP / ngrok catch-all blocks were removed at launch; the
#   whole stack is reached only through the real domains. If a dev tunnel is
#   ever needed again, see caddy/Caddyfile.tunnels.
# - The request bodies are compressed transparently with zstd+gzip via the
#   `encode` directive; two-byte-encoded responses negotiate zstd first and
#   fall back to gzip, which hurts nobody (all modern browsers send
#   Accept-Encoding).

# ── Global server options ────────────────────────────────────────────
{
    # HTTP/1.1 + HTTP/2 only. HTTP/3 (QUIC) stalls large downloads on mobile
    # networks — the transfer reaches 100% and never finalizes when the
    # end-of-stream packets are lost on a lossy path. The APK download is
    # the product's front door; keep it on the reliable transport.
    servers {
        protocols h1 h2
    }
}

# ── Shared security headers ──────────────────────────────────────────
(security_headers) {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

# ── Public waitlist landing page (UI only — API lives at api.*) ────
# www → apex: one canonical host keeps all SEO signals in one place.
www.matriq.com.ng {
    redir https://matriq.com.ng{uri} permanent
}

matriq.com.ng {
    root * /srv/waitlist
    encode zstd gzip
    import security_headers

    header {
        # Marketing site: nothing here needs camera/mic/geolocation/payment/UA data.
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), browsing-topics=()"
        # CSP: the only third-party code is Google Fonts (style/font) and the
        # three.js scene loaded from jsDelivr (script). The waitlist form posts
        # via fetch to api.matriq.com.ng (connect-src). 'unsafe-inline' style
        # covers the inline <style> blocks on the terms/privacy pages.
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' https://api.matriq.com.ng; upgrade-insecure-requests"
        # HTML and everything else: always revalidate.
        Cache-Control "no-cache"
    }

    # Telegram Mini App (served at /telegram-miniapp/): the bridge script
    # comes from telegram.org, and desktop Telegram embeds the app in an
    # iframe — the site-wide CSP/XFO lockdown gets an override here.
    @miniapp path /telegram-miniapp/*
    header @miniapp {
        -X-Frame-Options
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://telegram.org https://cdn.jsdelivr.net; connect-src 'self' https://api.matriq.com.ng; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; upgrade-insecure-requests"
    }

    # APK download: serve as a clean attachment with the real type and
    # filename so download managers finalize instead of hanging at 100%.
    @apk path /download/matriq.apk
    header @apk {
        Content-Type "application/vnd.android.package-archive"
        Content-Disposition "attachment; filename=\"matriq.apk\""
    }

    # Assets (3D scene, og-image, icons): stable names, 1-day mutable cache.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=86400, stale-while-revalidate=86400"

    @shortlived path /favicon.svg /apple-touch-icon.png /robots.txt /sitemap.xml /404.html
    header @shortlived Cache-Control "public, max-age=3600"

    # The in-app updater polls app-version.json on every launch — never cache.
    @version path /app-version.json
    header @version Cache-Control "no-store"

    # Waitlist UI only — the page's form calls api.matriq.com.ng directly
    # (cross-origin, CORS-enabled). No API surface on the website domain.
    # Stable APK download path for the app's in-app updater.
    handle_path /download/* {
        file_server
    }

    handle {
        file_server
    }

    # Branded 404 (waitlist/404.html) instead of Caddy's default error page.
    handle_errors {
        @not_found expression {err.status_code} == 404
        handle @not_found {
            rewrite * /404.html
            file_server
        }
        handle {
            respond "{err.status_code} {err.status_text}" 500
        }
    }
}

# ── Student web app (iPhone users) ─────────────────────────────────
# Static export of the mobile app (`cd mobile && npm run web:export`), copied
# to /srv/matriq-web on the VM. Login-gated client-side app — kept out of the
# search index on purpose (X-Robots-Tag on every response, plus an explicit
# disallow in /robots.txt).
app.matriq.com.ng {
    root * /srv/matriq-web
    encode zstd gzip
    import security_headers

    header {
        X-Robots-Tag "noindex, nofollow"
        Cache-Control "no-cache"
    }

    # Hashed Expo bundles: genuinely immutable.
    @expo path /_expo/*
    header @expo Cache-Control "public, max-age=31536000, immutable"

    @assets path /assets/*
    header @assets Cache-Control "public, max-age=86400, stale-while-revalidate=86400"

    # No public content on this host — tell crawlers explicitly.
    handle /robots.txt {
        respond "User-agent: *\nDisallow: /\n" 200
    }

    handle_errors {
        @not_found expression {err.status_code} == 404
        handle @not_found {
            respond "Not Found" 404
        }
        handle {
            respond "{err.status_code} {err.status_text}" 500
        }
    }

    try_files {path} /index.html
}

# ── API subdomain ──────────────────────────────────────────────────
api.matriq.com.ng {
    import security_headers

    header {
        Cache-Control "no-store"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    }

    reverse_proxy backend:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ── HTTP -> HTTPS redirect (our hosts only) ────────────────────────
http://matriq.com.ng, http://www.matriq.com.ng,
http://api.matriq.com.ng, http://app.matriq.com.ng {
    redir https://{host}{uri} permanent
}