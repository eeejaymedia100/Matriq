# Matriq — Caddy reverse proxy WITH self-hosted dashboards (TLS termination,
# HTTPS only per security.md). Swap target for scripts/enable-dashboards.sh.
# This is the regular Caddyfile plus two site blocks that proxy the Next.js
# dashboards running in Docker (dashboard:3001 / admin:3002) instead of Vercel.
#
# matriq.com.ng           → waitlist landing page (static) + /v1 proxied to backend
# api.matriq.com.ng       → backend API
# dashboard.matriq.com.ng → association dashboard (Docker, port 3001)
# admin.matriq.com.ng     → admin console (Docker, port 3002)
# Certificates: Caddy auto-issues Let's Encrypt certs once DNS resolves here
# (repoint the Cloudflare CNAMEs to VM A records before enabling).

# ── Public waitlist landing page (UI only — API lives at api.*) ────
matriq.com.ng, www.matriq.com.ng {
    root * /srv/waitlist
    encode gzip

    # Waitlist UI only — the page's form calls api.matriq.com.ng directly
    # (cross-origin, CORS-enabled). No API surface on the website domain.
    # Stable APK download path for the app's in-app updater.
    handle_path /download/* {
        file_server
    }

    handle {
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# ── Student web app (iPhone users) ─────────────────────────────────
# Static export of the mobile app (`cd mobile && npm run web:export`), copied
# to /srv/matriq-web on the VM. Gives iPhone users the full app in the
# browser — registration, dues, Vault, and the AI companion (cloud + OCR;
# on-device model support lands with the transformers.js engine, see
# docs/docs/web-app.md).
app.matriq.com.ng {
    root * /srv/matriq-web
    encode gzip
    try_files {path} /index.html

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# ── API subdomain ──────────────────────────────────────────────────
api.matriq.com.ng {
    reverse_proxy backend:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# ── Self-hosted Next.js dashboards (replaces Vercel) ───────────────
dashboard.matriq.com.ng {
    reverse_proxy dashboard:3001 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

admin.matriq.com.ng {
    reverse_proxy admin:3002 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# ── HTTP -> HTTPS redirect (our hosts only) ────────────────────────
http://matriq.com.ng, http://api.matriq.com.ng,
http://dashboard.matriq.com.ng, http://admin.matriq.com.ng,
http://app.matriq.com.ng {
    redir https://{host}{uri} permanent
}

# ── Temporary: raw VM IP API endpoint ───────────────────────────────
# Lets the mobile student app be tested TODAY while the .ng nameserver
# change propagates (up to 24h). Once DNS is live, clients switch to
# https://api.matriq.com.ng/v1 and this block can be removed.
http://34.91.191.164 {
    handle /v1/* {
        reverse_proxy backend:3000 {
            header_up Host api.matriq.com.ng
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto http
        }
    }
    # /health is proxied to the backend so external monitors and load tests
    # measure the API, not this static respond block.
    handle /health {
        reverse_proxy backend:3000 {
            header_up Host api.matriq.com.ng
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto http
        }
    }
    # Student APK download (mirrors the catch-all block below).
    handle_path /download/* {
        root * /srv/waitlist
        file_server
    }
    handle {
        respond "Matriq API — use /v1/*" 200
    }
}

# ── Catch-all (ngrok/dev tunnel): any host → API + APK download ─────
# Lets phones reach the API TODAY via an OUTBOUND ngrok tunnel (no
# inbound firewall needed). The tunnel forwards with a random *.ngrok
# Host header, so this block matches any unknown host on :80.
# Once the GCP firewall is open and DNS propagates, clients switch to
# https://api.matriq.com.ng/v1 and this block can be removed.
http:// {
    handle /v1/* {
        reverse_proxy backend:3000 {
            header_up Host api.matriq.com.ng
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
    # /health is proxied to the backend so external monitors and load tests
    # measure the API, not this static respond block.
    handle /health {
        reverse_proxy backend:3000 {
            header_up Host api.matriq.com.ng
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
    handle_path /download/* {
        root * /srv/waitlist
        file_server
    }
    handle {
        respond "Matriq API — use /v1/*" 200
    }
}
