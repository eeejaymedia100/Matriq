# Matriq — Caddy reverse proxy WITH self-hosted dashboards (TLS termination,
# HTTPS only per security.md). Swap target for scripts/enable-dashboards.sh.
# This mirrors the hardened production Caddyfile and adds two site blocks that
# proxy the Next.js dashboards running in Docker (dashboard:3001 /
# admin:3002) instead of Vercel.
#
# matriq.com.ng           → waitlist landing page (static)
# app.matriq.com.ng       → student web app (static React Native web export)
# api.matriq.com.ng       → backend API
# dashboard.matriq.com.ng → association dashboard (Docker, port 3001)
# admin.matriq.com.ng     → admin console (Docker, port 3002)
#
# Certificates: Caddy auto-issues Let's Encrypt certs once DNS resolves here
# (repoint the Cloudflare CNAMEs to VM A records before enabling).

# ── Shared security headers ──────────────────────────────────────────
(security_headers) {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

# ── Public waitlist landing page (UI only — API lives at api.*) ────
matriq.com.ng, www.matriq.com.ng {
    root * /srv/waitlist
    encode zstd gzip
    import security_headers

    header {
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), browsing-topics=()"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' https://api.matriq.com.ng; upgrade-insecure-requests"
        Cache-Control "no-cache"
    }

    @assets path /assets/*
    header @assets Cache-Control "public, max-age=86400, stale-while-revalidate=86400"

    @shortlived path /favicon.svg /apple-touch-icon.png /robots.txt /sitemap.xml /404.html
    header @shortlived Cache-Control "public, max-age=3600"

    @version path /app-version.json
    header @version Cache-Control "no-store"

    # Stable APK download path for the app's in-app updater.
    handle_path /download/* {
        file_server
    }

    handle {
        file_server
    }

    handle_errors {
        @not_found expression {err.status_code} == 404
        handle @not_found {
            rewrite * /404.html
            file_server
        }
        handle {
            respond "{err.status_code} {err.status_text}" 500
        }
    }
}

# ── Student web app (iPhone users) ─────────────────────────────────
app.matriq.com.ng {
    root * /srv/matriq-web
    encode zstd gzip
    import security_headers

    header {
        X-Robots-Tag "noindex, nofollow"
        Cache-Control "no-cache"
    }

    @expo path /_expo/*
    header @expo Cache-Control "public, max-age=31536000, immutable"

    @assets path /assets/*
    header @assets Cache-Control "public, max-age=86400, stale-while-revalidate=86400"

    handle /robots.txt {
        respond "User-agent: *\nDisallow: /\n" 200
    }

    handle_errors {
        @not_found expression {err.status_code} == 404
        handle @not_found {
            respond "Not Found" 404
        }
        handle {
            respond "{err.status_code} {err.status_text}" 500
        }
    }

    try_files {path} /index.html
}

# ── API subdomain ──────────────────────────────────────────────────
api.matriq.com.ng {
    import security_headers

    header {
        Cache-Control "no-store"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    }

    reverse_proxy backend:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ── Self-hosted Next.js dashboards (replaces Vercel) ───────────────
dashboard.matriq.com.ng {
    import security_headers
    reverse_proxy dashboard:3001 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

admin.matriq.com.ng {
    import security_headers
    reverse_proxy admin:3002 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ── HTTP -> HTTPS redirect (our hosts only) ────────────────────────
http://matriq.com.ng, http://www.matriq.com.ng,
http://api.matriq.com.ng, http://app.matriq.com.ng,
http://dashboard.matriq.com.ng, http://admin.matriq.com.ng {
    redir https://{host}{uri} permanent
}